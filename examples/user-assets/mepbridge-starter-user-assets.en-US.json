                    { "x": -1.693238115, "y": -7.225874143, "z": 2.5 },
                    { "x": 5.001537618, "y": -7.225874143, "z": 2.5 },
                    { "x": 5.001537618, "y": -11.12, "z": 2.5 }
                  ],
                  "width": 0.2,
                  "height": 0.1,
