    {
      "id": "tpl-starter-scan-structure",
      "name": "Create sample slab",
      "category": "Building",
      "icon": "SLAB",
      "description": "Creates a 15.55m x 14.55m rectangular sample slab on story 0 at level 0.000m with a thickness of 0.30m, using the verified native source coordinates (same position as the source slab).",
      "plan": {
        "title": "Create sample slab",
        "warning": "This template writes to the Archicad model. Auto mode executes directly; supervised and manual modes require confirmation.",
        "isMutation": true,
        "mepCode": "CreateSlab",
        "steps": [
          {
            "id": "step-create-sample-slab",
            "title": "Create story-0 sample slab",
            "action": "CreateSlab",
            "description": "Create the slab from live-read parameters using the source slab's native coordinates (no offset).",
            "expectedResult": "Creates one Slab with floorIndex=0, level=0, and thickness=0.30m.",
            "params": {
              "polygon": [
                { "x": -6.24, "y": -11.37 },
                { "x": 9.31, "y": -11.37 },
                { "x": 9.31, "y": 3.18 },
                { "x": -6.24, "y": 3.18 }
              ],
              "thickness": 0.3,
              "level": 0,
              "floorIndex": 0,
              "dryRun": false,
              "confirmRequired": true
            },
            "commandJson": {
              "command": "API.ExecuteAddOnCommand",
              "parameters": {
                "addOnCommandId": {
                  "commandNamespace": "MEPBridge",
                  "commandName": "CreateSlab"
                },
                "addOnCommandParameters": {
                  "polygon": [
                    { "x": -6.24, "y": -11.37 },
                    { "x": 9.31, "y": -11.37 },
                    { "x": 9.31, "y": 3.18 },
                    { "x": -6.24, "y": 3.18 }
                  ],
                  "thickness": 0.3,
                  "level": 0,
                  "floorIndex": 0,
                  "dryRun": false,
                  "confirmRequired": true
                }
              }
            },
            "commandNamespace": "MEPBridge",
            "commandName": "CreateSlab",
            "descriptorName": "mepbridge.CreateSlab",
            "riskLevel": "low-mutation",
            "status": "pending"
          }
        ],
        "parameters": [
          {
            "item": "Slab outline",
            "expected": "15.55m x 14.55m rectangle with four vertices",
            "actual": "Pending execution",
            "status": "warning"
          },
          {
            "item": "Story and thickness",
            "expected": "floorIndex=0, level=0.00m, thickness=0.30m",
            "actual": "Pending execution",
            "status": "warning"
          }
        ]
      },
      "riskLevel": "low-mutation",
      "createdAt": "2026-07-22T00:00:00.000+08:00",
      "updatedAt": "2026-07-24T00:00:00.000+08:00",
      "tags": ["starter", "example", "release-preset", "en-US"],
      "usageCount": 0,
      "version": "1.3",
      "notes": "Parameters come from the current AC28 story-0 slab read/recreate regression. Coordinates use the source slab's native position (no X offset)."
